# syntax=docker/dockerfile:1

FROM docker.m.daocloud.io/library/node:22.23.4-alpine AS web-build
WORKDIR /web
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    COREPACK_NPM_REGISTRY=https://registry.npmmirror.com \
    npm_config_registry=https://registry.npmmirror.com
RUN npm install --global corepack@0.34.6

COPY web/package.json web/pnpm-lock.yaml web/pnpm-workspace.yaml web/.npmrc ./
RUN --mount=type=cache,id=pnpm10-store,target=/pnpm/store,sharing=locked \
    corepack pnpm install --store-dir=/pnpm/store --frozen-lockfile

COPY web/ ./
RUN corepack pnpm build

FROM docker.m.daocloud.io/library/python:3.12-slim

ENV PATH="/app/.venv/bin:$PATH" \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    AGENT_RELAY_SERVER__HOST=0.0.0.0 \
    AGENT_RELAY_SERVER__PORT=80

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY config ./config
COPY alembic.ini ./alembic.ini
COPY migrations ./migrations

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir uv==0.12.5 \
    && uv sync --locked --no-dev --no-editable \
    && useradd --create-home --uid 10001 appuser \
    && install -d -o appuser -g appuser /app/logs /app/data

COPY --from=web-build /web/dist ./static

USER appuser
EXPOSE 80
CMD ["python", "-m", "agent_relay.server"]
