{
  "name": "agent-relay-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vue-tsc --noEmit && vite build --mode prod",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --fix-type=problem",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "1.70.0",
    "@tiptap/core": "3.33.1",
    "@tiptap/vue-3": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/extension-mention": "3.33.1",
    "@tiptap/suggestion": "3.33.1",
    "@tiptap/extensions": "3.33.1",
    "axios": "^1.20.0",
    "markdown-it": "^15.0.3",
    "pinia": "^3.0.3",
    "reka-ui": "2.11.0",
    "vue": "3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.19",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-typescript": "^14.3.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^9.32.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.2.0"
  }
