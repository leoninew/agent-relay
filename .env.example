# Copy to .env.<profile>; select it with profile=<profile> or CONFLUA_PROFILE.
CONFLUA_SERVER__HOST=127.0.0.1
CONFLUA_SERVER__PORT=9081
CONFLUA_SERVER__RELOAD=false
CONFLUA_STATIC__DIRECTORY=./static
CONFLUA_DATABASE__PATH=./data/conflua.db
CONFLUA_CODEX__COMMAND=["codex", "app-server", "proxy"]
CONFLUA_CODEX__RPC_TIMEOUT=30
