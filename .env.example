# Copy to .env.<profile>; select it with profile=<profile> or AGENT_RELAY_PROFILE.
AGENT_RELAY_GREETING__PREFIX=Hello
AGENT_RELAY_SERVER__HOST=127.0.0.1
AGENT_RELAY_SERVER__PORT=9080
AGENT_RELAY_SERVER__RELOAD=false
AGENT_RELAY_STATIC__DIRECTORY=./static
AGENT_RELAY_DATABASE__PATH=./data/agent-relay.sqlite3
AGENT_RELAY_CODEX__COMMAND=["codex", "app-server", "proxy"]
AGENT_RELAY_CODEX__RPC_TIMEOUT=30
